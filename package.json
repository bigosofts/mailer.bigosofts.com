{
  "name": "simple-mail-api",
  "version": "1.0.0",
  "description": "Single page Node.js mail API",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "git:push": "git add --all && git commit -m \"small update 2\" && git pull --no-rebase origin main && git push origin main",
    "git:pull": "git pull --no-rebase origin main",
    "git:reset": "git reset --hard HEAD && git clean -fd"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
